<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <div class="login-container">
    <form onsubmit="return validateLoginForm()" action="/admin/login" method="POST">
      <div class="login-frame">
        <div class="login-top">
          <span>Login</span>
          <div>Go back <a href="/admin" class="link-highlight">Home</a></div>
          <p>
            Not registered yet?
            <a href="/admin/signup" class="link-highlight">Signup</a>
          </p>
        </div>

        <div class="login-input-frame">
          <div class="login-up-frame">
            <label>Username *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              required
            />
          </div>
        </div>

        <div class="login-input-frame">
          <div class="login-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              required
            />
          </div>
        </div>

        <button class="login-btn btn" name="login" type="submit">
          Login
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/login.js"></script>
</body>

<%- include('includes/footer') %>